# =========================================================================
# MedPulse Hospital Patient Data Analysis and Management System
# Production & Deployment Environment Variables (Template / Safe Example)
# =========================================================================

# Application & Environment Mode
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0

# JWT Authentication Security
# Generate a cryptographically secure 64-character hex key in production using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-your-strong-production-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OTP & Two-Factor Authentication
# Set to 'false' in production to require real SMS/authenticator codes
ENABLE_DEMO_OTP=false

# CORS & Domain Whitelisting
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://your-hospital-frontend.vercel.app
FRONTEND_URL=https://your-hospital-frontend.vercel.app

# MongoDB Database Configuration (Primary Storage & Atlas Integration)
# For Render / Production, paste your MongoDB Atlas connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=hospital_management_db
DATABASE_NAME=hospital_management_db
STORAGE_MODE=auto

# MongoDB Atlas Connection Pooling & Timeout Settings (Optional fine-tuning)
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=3000
MONGODB_MAX_IDLE_TIME_MS=45000

# MySQL Academic Relational Database (SQL Deliverables)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=hospital_admin
MYSQL_PASSWORD=replace-with-secure-database-password
MYSQL_DATABASE=hospital_management_db
